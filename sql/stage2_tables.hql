-- Stage II: Hive table setup for team20_projectdb
-- Generated by scripts/generate_stage2_hql.py

DROP DATABASE IF EXISTS team20_projectdb CASCADE;
CREATE DATABASE IF NOT EXISTS team20_projectdb
LOCATION '/user/team20/project/hive/warehouse';
USE team20_projectdb;

CREATE EXTERNAL TABLE IF NOT EXISTS train_transaction
ROW FORMAT SERDE 'org.apache.hadoop.hive.serde2.avro.AvroSerDe'
STORED AS INPUTFORMAT 'org.apache.hadoop.hive.ql.io.avro.AvroContainerInputFormat'
OUTPUTFORMAT 'org.apache.hadoop.hive.ql.io.avro.AvroContainerOutputFormat'
LOCATION '/user/team20/project/warehouse/train_transaction/'
TBLPROPERTIES ('avro.schema.url'='hdfs:///user/team20/project/warehouse/avsc/train_transaction.avsc');

CREATE EXTERNAL TABLE IF NOT EXISTS train_identity
ROW FORMAT SERDE 'org.apache.hadoop.hive.serde2.avro.AvroSerDe'
STORED AS INPUTFORMAT 'org.apache.hadoop.hive.ql.io.avro.AvroContainerInputFormat'
OUTPUTFORMAT 'org.apache.hadoop.hive.ql.io.avro.AvroContainerOutputFormat'
LOCATION '/user/team20/project/warehouse/train_identity/'
TBLPROPERTIES ('avro.schema.url'='hdfs:///user/team20/project/warehouse/avsc/train_identity.avsc');

CREATE EXTERNAL TABLE IF NOT EXISTS test_transaction
ROW FORMAT SERDE 'org.apache.hadoop.hive.serde2.avro.AvroSerDe'
STORED AS INPUTFORMAT 'org.apache.hadoop.hive.ql.io.avro.AvroContainerInputFormat'
OUTPUTFORMAT 'org.apache.hadoop.hive.ql.io.avro.AvroContainerOutputFormat'
LOCATION '/user/team20/project/warehouse/test_transaction/'
TBLPROPERTIES ('avro.schema.url'='hdfs:///user/team20/project/warehouse/avsc/test_transaction.avsc');

CREATE EXTERNAL TABLE IF NOT EXISTS test_identity
ROW FORMAT SERDE 'org.apache.hadoop.hive.serde2.avro.AvroSerDe'
STORED AS INPUTFORMAT 'org.apache.hadoop.hive.ql.io.avro.AvroContainerInputFormat'
OUTPUTFORMAT 'org.apache.hadoop.hive.ql.io.avro.AvroContainerOutputFormat'
LOCATION '/user/team20/project/warehouse/test_identity/'
TBLPROPERTIES ('avro.schema.url'='hdfs:///user/team20/project/warehouse/avsc/test_identity.avsc');

